Options -Indexes
RewriteEngine On

# ── Seguridad: bloquear acceso directo a carpetas privadas ────
RewriteRule ^(content|backups)/ - [F,L]

# ── Primera ejecución: servir el instalador ───────────────────
# Mientras no exista newsday-config.php (y no se pida ya el instalador o
# la API), servir el instalador con un rewrite INTERNO. El rewrite interno
# evita el Location malformado del redirect externo; el instalador es
# autocontenido. index.php aplica el mismo guard para la home con __DIR__
# (válido también en subdirectorio).
RewriteCond %{DOCUMENT_ROOT}/newsday-config.php !-f
RewriteCond %{REQUEST_URI} !/newsday-install\.php$ [NC]
RewriteCond %{REQUEST_URI} !/newsday-api\.php$ [NC]
RewriteRule ^ newsday-install.php [L]
