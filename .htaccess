Options -Indexes
RewriteEngine On

# ── Seguridad: bloquear acceso directo a carpetas privadas ────
RewriteRule ^(content|backups)/ - [F,L]

# ── Primera ejecución: redirigir al instalador ────────────────
# Mientras no exista newsday-config.php (y no se pida ya el instalador o
# la API), redirigir al instalador. El destino es root-relative
# (/newsday-install.php) para que el Location salga bien formado; el
# redirect externo relativo metía la ruta del filesystem en el Location.
# index.php aplica el mismo guard con __DIR__ para instalaciones en
# subdirectorio.
RewriteCond %{DOCUMENT_ROOT}/newsday-config.php !-f
RewriteCond %{REQUEST_URI} !/newsday-install\.php$ [NC]
RewriteCond %{REQUEST_URI} !/newsday-api\.php$ [NC]
RewriteRule ^ /newsday-install.php [R=302,L]
